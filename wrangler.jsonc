// Cloudflare Worker configuration. Cloudflare reads this file on every deploy from GitHub.
{
  "name": "risk-appetite",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Only reachable at the custom domain (behind Cloudflare Access sign-in).
  // The default workers.dev address and preview addresses are switched off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "risk-appetite.triodian.com", "custom_domain": true }],

  "d1_databases": [
    { "binding": "DB", "database_name": "risk-appetite-db", "database_id": "REPLACE_WITH_DATABASE_ID" }
  ],
  "observability": { "enabled": true }
}
