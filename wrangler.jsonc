// Cloudflare Worker configuration. Cloudflare reads this file on every deploy from GitHub.
{
  "name": "risk-appetite",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // run_worker_first: every request reaches src/worker.js first, so pages can require sign-in (lib/identity/session.js).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  // Only reachable at the custom domain (behind Cloudflare Access sign-in).
  // The default workers.dev address and preview addresses are switched off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "risk-appetite.triodian.com", "custom_domain": true }],

  "d1_databases": [
    { "binding": "DB", "database_name": "risk-appetite-db", "database_id": "9bd12781-030b-4940-8989-17e4858d2247" },
    { "binding": "IDENTITY", "database_name": "triodian-identity-db", "database_id": "d2031f39-53b4-438c-aed6-1d480f9526bf" }
  ],
  // IDENTITY (development plan tasks 1B.2 and 1B.3): the suite's shared identity database, one per environment, bound to
  // all four engagement apps. With it, people are added once, roles are kept per app, and one sign-in covers every app
  // on SUITE_COOKIE_DOMAIN (the cookie SUITE_SESSION_COOKIE; the test sites use their own name so live and test stay apart).
  // Each app copies its own users in the first time it starts with the binding. The databases are triodian-identity-db
  // (live) and triodian-identity-test-db (test). Both are bound below.
  "observability": { "enabled": true },

  // Daily at 07:00 Brisbane time: remind people about "not set" positions due soon (see lib/core/notify.js).
  "triggers": { "crons": ["0 21 * * *"] },

  // Email notifications are switched on. They are sent from notifications@triodian.com (a Google Workspace
  // mailbox, so replies arrive there) through Cloudflare Email Service, which needs triodian.com onboarded in
  // Email Service (Email Sending). Until it is, each send fails and is listed as Failed, with the reason, in
  // Admin → Notifications; saves are never affected. To stop sending, set NOTIFY_SENDING to "off".
  "send_email": [{ "name": "EMAIL" }],
  // DEMO_ADMINS (demo addition): comma-separated emails made active administrators when they sign in.
  // Empty it ("") on a client deployment. See lib/core/api.js.
  // DEMO_LOGIN (demo addition, a Worker secret, not set here): username sign-in for the shared trio_demo account,
  // its password held only as a PBKDF2 hash. It is a secret so the hash is not public; see docs/demo-sign-in.md.
  // DEMO_SESSION_KEY (a Worker secret, not set here) signs the demo sign-in cookie, shared across triodian.com; it
  // must be the same in every Triodian app and is only ever accepted for the demo account's own email. See lib/identity/session.js.
  "vars": { "SUITE_DEMO": "on", "SUITE_COOKIE_DOMAIN": "triodian.com", "SUITE_SESSION_COOKIE": "tri_suite", "DEMO_ADMINS": "demo@triodian.com", "NOTIFY_FROM": "notifications@triodian.com", "NOTIFY_SENDING": "on" },

  // Test copy of the site: risk-appetite-test.triodian.com, with its own database.
  // Deployed with `npx wrangler deploy --env test` (see docs/test-site.md).
  "env": {
    "test": {
      "name": "risk-appetite-test",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "risk-appetite-test.triodian.com", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "risk-appetite-test-db", "database_id": "abb02586-fc71-4b8b-a6fc-7487d4b606b3" },
        { "binding": "IDENTITY", "database_name": "triodian-identity-test-db", "database_id": "4d7591a1-bcb7-4514-b726-f0621d7de25a" }
      ],
      "vars": { "SUITE_DEMO": "on", "SUITE_COOKIE_DOMAIN": "triodian.com", "SUITE_SESSION_COOKIE": "tri_suite_test", "DEMO_ADMINS": "demo@triodian.com", "SITE_LABEL": "Test site", "SITE_URL": "https://risk-appetite-test.triodian.com", "NOTIFY_FROM": "notifications@triodian.com", "NOTIFY_SENDING": "on" },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["0 21 * * *"] },
      "observability": { "enabled": true }
    },

    // CLIENT DEPLOYMENT PROFILE (development plan task 0.2): a copy of AI Risk Appetite for one client, with no demonstration
    // parts. No demo sign-in (DEMO_LOGIN empty), no demo administrators, no demo band or app switcher (SUITE_DEMO off),
    // and DEMO_SESSION_KEY is not set as a secret. To deploy one: replace the CLIENT placeholders, create the client's
    // D1 database and put its id below, create the client's Access application for /auth/email and set its tag as
    // the ACCESS_AUD secret (the team domain is in lib/config.js), then run `npx wrangler deploy --env client`.
    // Email stays held (NOTIFY_SENDING off) until the client's sender is set up.
    "client": {
      "name": "risk-appetite-client",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "risk-appetite.CLIENT-DOMAIN.example", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "risk-appetite-client-db", "database_id": "REPLACE-WITH-THE-CLIENT-DATABASE-ID" }
      ],
      "vars": { "SUITE_DEMO": "off", "SUITE_COOKIE_DOMAIN": "CLIENT-DOMAIN.example", "SUITE_SESSION_COOKIE": "tri_suite", "DEMO_LOGIN": "", "DEMO_ADMINS": "", "SITE_URL": "https://risk-appetite.CLIENT-DOMAIN.example", "NOTIFY_SENDING": "off", "NOTIFY_FROM": "" },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["0 21 * * *"] },
      "observability": { "enabled": true }
    }
  }
}
